# Ground Truth environment variables. All optional; the app runs with none set.
# They apply to export_static.py and the live JSON API, not to the static page.
#
# CENSUS_API_KEY enables the optional "measured" citywide per-bedroom medians
# from the Census ACS. Without it the app still works, using the Zillow ZORI +
# Apartment List benchmark. Get a free key at:
# https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Optional Socrata app token; raises the DataSF rate limit for large fetches.
SODA_APP_TOKEN=

# Port for the local server (default 8000).
PORT=8000
